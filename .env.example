# Copy this file to .env and fill in your own values. NEVER commit .env.
# ---- Browser (public) values ----
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
VITE_SUPABASE_PROJECT_ID=your-project-ref
# "supabase" = Google sign-in through your own Supabase project
VITE_AUTH_MODE=supabase

# ---- Server-only values (set in your hosting provider settings) ----
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SERVICE_ROLE_KEY=your-secret-key
# AI tutor + speaking practice (Google Gemini)
GEMINI_API_KEY=your-gemini-key
GEMINI_MODEL=gemini-flash-lite-latest
# Hosting target for the standalone build: cloudflare-module | vercel | netlify | node-server
NITRO_PRESET=node-server
